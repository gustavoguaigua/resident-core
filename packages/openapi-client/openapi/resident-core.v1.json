        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadinessResponseDto"
                }
              }
            },
            "description": "All configured platform dependencies are ready."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            },
            "description": "The caller is not authorized to inspect platform readiness."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            },
            "description": "An uncontrolled platform failure occurred."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadinessResponseDto"
                }
              }
            },
            "description": "At least one configured platform dependency is unavailable."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Report platform dependency readiness",
        "tags": [
          "Health"
        ],
        "x-auth-required": true,
        "x-health-endpoint": true,
        "x-platform-only": true,
        "x-public": false,
        "x-required-permission": "platform.health.read",
        "x-response-envelope": false,
        "x-tenant-context-required": false
      }
    },
