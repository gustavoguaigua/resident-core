{
  "name": "resident-core",
  "version": "0.1.0",
  "private": true,
  "description": "RESIDENT Core - multitenant residential administration platform",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @resident/api test:api",
    "test:integration": "pnpm --filter @resident/api test:integration",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:config": "docker compose config --quiet",
    "docker:build:api": "docker compose build resident-api",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:check": "node tools/prisma/run-phase-2-gate.mjs",
    "test:audit": "node tools/audit/run-phase-3-gate.mjs",
    "bootstrap:platform-admin": "tsx --tsconfig apps/api/tsconfig.json apps/api/tools/bootstrap-platform-admin.ts",
    "test:bootstrap": "node tools/bootstrap/run-phase-4-gate.mjs",
    "test:authorization": "node tools/authorization/run-phase-5-gate.mjs authorization",
    "test:multitenancy": "node tools/authorization/run-phase-5-gate.mjs multitenancy",
    "test:tenants": "node tools/tenants/run-phase-6-gate.mjs",
    "test:invitations": "node tools/invitations/run-phase-7-gate.mjs",
    "settings:seed": "node tools/settings/seed-settings.mjs",
    "test:settings": "node tools/settings/run-phase-8-gate.mjs",
    "test:residents:persistence": "node tools/residents/run-phase-1-gate.mjs",
    "test:stack:smoke": "node tools/stack/run-phase-9-smoke.mjs",
    "openapi:check": "pnpm --filter @resident/api openapi:check",
    "openapi:generate": "pnpm --filter @resident/api openapi:generate",
    "openapi:validate": "pnpm --filter @resident/openapi-client validate",
    "security:dependencies": "pnpm audit --audit-level high",
    "security:secrets": "pnpm --filter @resident/testing security:secrets",
    "keycloak:bootstrap": "node tools/keycloak/bootstrap-local.mjs",
    "keycloak:verify": "node tools/keycloak/run-phase-1-gate.mjs verify",
    "test:keycloak": "node tools/keycloak/run-phase-1-gate.mjs test",
    "sprint1:boundary": "pnpm --filter @resident/testing sprint1:boundary",
    "sprint2:boundary": "pnpm --filter @resident/testing sprint2:boundary",
    "sprint2:gates": "pnpm --filter @resident/testing sprint2:gates",
    "sprint3:boundary": "pnpm --filter @resident/testing sprint3:boundary",
    "sprint3:gates": "pnpm --filter @resident/testing sprint3:gates"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/client": "6.19.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "prisma": "6.19.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.21.0"
  }
}
