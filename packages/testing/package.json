{
  "name": "@resident/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test tools",
    "security:secrets": "node tools/secret-scan.mjs",
    "sprint1:boundary": "node tools/verify-sprint-1-boundary.mjs",
    "sprint2:boundary": "node tools/verify-sprint-2-boundary.mjs",
    "sprint2:gates": "node tools/run-sprint-2-gates.mjs",
    "sprint3:boundary": "node tools/verify-sprint-3-boundary.mjs",
    "sprint3:gates": "node tools/run-sprint-3-gates.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.21.0"
  }
}
